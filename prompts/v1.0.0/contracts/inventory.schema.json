{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Staged inventory v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticketId", "changes"],
  "properties": {
    "ticketId": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
    "changes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001f]).+$",
        "not": { "pattern": "/$" }
      }
    }
  }
}
