{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Staged descriptions v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticketId", "changes"],
  "properties": {
    "ticketId": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*$" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filename", "change_description"],
        "properties": {
          "filename": { "type": "string", "minLength": 1 },
          "change_description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
